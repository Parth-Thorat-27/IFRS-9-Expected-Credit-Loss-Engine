# Copy this file to .env and set your own passwords. .env is git-ignored.
# docker-compose.yml, scripts/lib/common.sh and python/ecl/db.py all read it,
# so the three clients always agree on how to reach the database.
#
# Passwords: letters, digits and underscore only. Characters such as @ / " $
# have special meaning in SQL*Plus connect strings or in the shell.

# SYS and SYSTEM password inside the container. Only setup_db.sh uses SYSTEM,
# to create the directory objects that the ECL account is not allowed to create.
ORACLE_PASSWORD=ChangeMe_Sys1

# Application schema, created by the gvenzl image on first start.
APP_USER=ECL
APP_USER_PASSWORD=ChangeMe_Ecl1

# Where python-oracledb connects from the host (thin mode, no Instant Client).
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# Container that the bash scripts `docker exec` SQL*Plus in.
ORACLE_CONTAINER=ecl-oracle
